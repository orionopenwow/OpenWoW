+/// The launcher (launcher/herokey_v2.py) makes the same Hero ID and signature from a key as the realm.
+#[test]
+fn the_launchers_hero_id_matches_the_realms() {
+    let secret = "AAECAwQFBgcICQoLDA0ODxAREhMUFRYXGBkaGxwdHh8";
+    assert_eq!(herokey::hero_id(&herokey::hero_pub_of(secret).unwrap()), "ovh1.GVSN6lA0SzCD8nQfZIyrChuVy5ERLpDJNQT1xssI-Sg");
+    let pubk = herokey::hero_pub_of(secret).unwrap();
+    assert!(herokey::hero_verify(&pubk, b"openvanilla-hero-v1\nchallenge:xyz",
+        "Jj6N8o8wysGSr1KlLlyU3cXs-bONUscRi0tuTWgH4mOuR2ILW3v8wgfoFDDpcZGHGusYKOOrZ3lsrXXsZBTYCg"));
