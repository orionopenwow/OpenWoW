+// -- Open Vanilla 0042: the launcher's Google button and its own Hero Key sign-in -------------------
+
+#[tokio::test]
+async fn the_launcher_signs_in_with_google_or_its_own_hero_key() {
+    let _env = DISCORD_ENV.lock().unwrap_or_else(std::sync::PoisonError::into_inner);
+    std::env::set_var("OPENVANILLA_GUESTS", "1");
+    std::env::remove_var("DISCORD_SIGNIN");
+    let g = mock_google().await;
+    std::env::set_var("GOOGLE_CLIENT_ID", "123-abc.apps.googleusercontent.com");
+    std::env::set_var("GOOGLE_CLIENT_SECRET", "gs");
+    std::env::set_var("GOOGLE_AUTHORIZE_URL", format!("{g}/authorize"));
+    std::env::set_var("GOOGLE_TOKEN_URL", format!("{g}/token"));
+    std::env::set_var("GOOGLE_USERINFO_URL", format!("{g}/userinfo"));
+    let google = wenilla_realm::auth::google::Google::from_env().unwrap().unwrap();
+    let h = harness_with(vec![Arc::new(google)]).await;
+    run_setup(&h).await;
+
+    // Continue with Google: straight to Google, then back through the launcher's finish
+    let r = send(&h.app, get("/auth/launcher?port=50123&state=abcdefghijklmnopqrstuvwx&via=google", None)).await;
+    assert_eq!(r.location(), "/auth/google/start", "{}", r.body);
+    let pending = named(&r, "wr_launcher").expect("the launcher waits");
+    let r = send(&h.app, get("/auth/google/start", Some(&pending))).await;
+    assert!(r.location().starts_with(&format!("{g}/authorize")), "{}", r.location());
+    let state = query_param(r.location(), "state");
+    let oauth = named(&r, "wr_oauth").unwrap();
+    let r = send(&h.app, get(&format!("/auth/google/callback?code=OK&state={state}"), Some(&format!("{pending}; {oauth}")))).await;
+    assert_eq!(r.location(), "/auth/launcher/finish", "{}", r.body);
+    let sess = named(&r, "wr_session").expect("signed in with Google");
+    let r = send(&h.app, get("/auth/launcher/finish", Some(&format!("{pending}; {sess}")))).await;
+    assert!(r.location().starts_with("http://127.0.0.1:50123/openvanilla-signin?code="), "{}", r.location());
+    let code = query_param(r.location(), "code");
+    let r = send(&h.app, json_post("/api/launcher/token", serde_json::json!({ "code": code }))).await;
+    assert_eq!(r.status, StatusCode::OK, "{}", r.body);
+    let creds: serde_json::Value = serde_json::from_str(&r.body).unwrap();
+    let token = creds["token"].as_str().unwrap().to_string();
+    let game_user = creds["user"].as_str().unwrap().to_string();
+
+    // the Hero Key page and the switch both follow `via`
+    let r = send(&h.app, get("/auth/launcher?port=50123&state=abcdefghijklmnopqrstuvwx&via=key", None)).await;
+    assert_eq!(r.location(), "/key");
+    let r = send(&h.app, get("/auth/launcher?port=50123&state=abcdefghijklmnopqrstuvwx&switch=1&via=google", Some(&sess))).await;
+    assert_eq!(r.location(), "/auth/google/start");
+
+    // the launcher keeps the account's Hero Key: the first is made for it
+    let mut req = json_post("/api/launcher/herokey", serde_json::json!({}));
+    req.headers_mut().insert(header::AUTHORIZATION, format!("Bearer {token}").parse().unwrap());
+    let r = send(&h.app, req).await;
+    assert_eq!(r.status, StatusCode::OK, "{}", r.body);
+    let j: serde_json::Value = serde_json::from_str(&r.body).unwrap();
+    let key = j["key"].as_str().expect("a first key").to_string();
+    assert!(key.starts_with("ovk1."), "{key}");
+    // asked again: the realm never shows a key twice
+    let mut req = json_post("/api/launcher/herokey", serde_json::json!({}));
+    req.headers_mut().insert(header::AUTHORIZATION, format!("Bearer {token}").parse().unwrap());
+    let j: serde_json::Value = serde_json::from_str(&send(&h.app, req).await.body).unwrap();
+    assert_eq!(j["has_key"], true);
+    assert!(j.get("key").is_none());
+    // no token: nothing
+    let r = send(&h.app, json_post("/api/launcher/herokey", serde_json::json!({}))).await;
+    assert_eq!(r.status, StatusCode::UNAUTHORIZED);
+
+    // and signs in with it later, no browser: a signed challenge, the same answer as the token
+    let launcher = |path: &str, body: serde_json::Value| {
+        Request::post(path).header(header::CONTENT_TYPE, "application/json").body(Body::from(body.to_string())).unwrap()
+    };
+    let challenge = new_challenge(&h).await;
+    let sig = herokey::hero_sign(&key[16..], format!("openvanilla-hero-v1\nchallenge:{challenge}").as_bytes()).unwrap();
+    let body = serde_json::json!({ "key_id": &key[5..15], "hero": hero_of(&key), "challenge": challenge, "sig": sig });
+    let r = send(&h.app, launcher("/api/launcher/hero", body.clone())).await;
+    assert_eq!(r.status, StatusCode::OK, "{}", r.body);
+    let j: serde_json::Value = serde_json::from_str(&r.body).unwrap();
+    assert_eq!(j["user"].as_str().unwrap(), game_user, "the same game account");
+    assert!(j["token"].as_str().unwrap().len() > 20 && j["pass"].as_str().is_some());
+    // a challenge works once
+    let r = send(&h.app, launcher("/api/launcher/hero", body)).await;
+    assert_eq!(r.status, StatusCode::UNAUTHORIZED, "{}", r.body);
+    // a wrong signature fails
+    let challenge = new_challenge(&h).await;
+    let other = herokey::hero_sign(&key[16..], b"something else").unwrap();
+    let body = serde_json::json!({ "key_id": &key[5..15], "hero": hero_of(&key), "challenge": challenge, "sig": other });
+    assert_eq!(send(&h.app, launcher("/api/launcher/hero", body)).await.status, StatusCode::UNAUTHORIZED);
+    // a replaced key stops at once
+    let mut req = json_post("/api/launcher/herokey", serde_json::json!({ "replace": true }));
+    req.headers_mut().insert(header::AUTHORIZATION, format!("Bearer {token}").parse().unwrap());
+    let j: serde_json::Value = serde_json::from_str(&send(&h.app, req).await.body).unwrap();
+    let newer = j["key"].as_str().unwrap().to_string();
+    assert_ne!(newer, key);
+    let challenge = new_challenge(&h).await;
+    let sig = herokey::hero_sign(&key[16..], format!("openvanilla-hero-v1\nchallenge:{challenge}").as_bytes()).unwrap();
+    let body = serde_json::json!({ "key_id": &key[5..15], "hero": hero_of(&key), "challenge": challenge, "sig": sig });
+    assert_eq!(send(&h.app, launcher("/api/launcher/hero", body)).await.status, StatusCode::UNAUTHORIZED);
+
+    for k in ["GOOGLE_CLIENT_ID", "GOOGLE_CLIENT_SECRET", "GOOGLE_AUTHORIZE_URL", "GOOGLE_TOKEN_URL", "GOOGLE_USERINFO_URL"] {
+        std::env::remove_var(k);
+    }
+}
