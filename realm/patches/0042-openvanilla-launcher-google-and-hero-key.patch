+/// `POST /api/launcher/hero` (Open Vanilla 0042): the launcher signs a challenge with the Hero Key it
+/// keeps; the answer is `/api/launcher/token`'s (the game account and a launcher token). Not a browser
+/// form, so no same-site check; the same counters as the other Hero Key sign-ins.
+async fn launcher_hero(
+    State(state): State<Arc<AppState>>,
+    headers: HeaderMap,
+    Json(f): Json<HeroSignIn>,
+) -> Result<Response, AppError> {
+    let no = |status: StatusCode, msg: &str| json_status(status, serde_json::json!({ "ok": false, "message": msg }));
+    let ip = client_ip(&headers);
+    if !state.limiter.allow(&format!("herokey:net:{}", net_of(&headers)), 20, 900) {
+        audit::log(&state.db, None, ip.as_deref(), "login.limited", Some("herokey"), Some("launcher")).await;
+        return Ok(no(StatusCode::TOO_MANY_REQUESTS, "Too many tries. Wait 15 minutes and try again."));
+    }
+    let key_id = f.key_id.trim();
+    if key_id.len() != ID_LEN || !key_id.bytes().all(|b| b.is_ascii_alphanumeric()) {
+        return Ok(no(StatusCode::BAD_REQUEST, "That doesn't look like a Hero Key. It starts with ovk1."));
+    }
+    if !state.limiter.allow(&format!("herokey:id:{key_id}"), 10, 900) {
+        return Ok(no(StatusCode::TOO_MANY_REQUESTS, "Too many tries with that key. Wait 15 minutes and try again."));
+    }
+    if f.challenge.len() > 64 || !take_challenge(&state.db, &f.challenge).await? {
+        return Ok(no(StatusCode::UNAUTHORIZED, "That took too long. Try again."));
+    }
+    let row: Option<(i64, Option<Vec<u8>>, i64)> = sqlx::query_as(
+        "SELECT k.user_id, k.hero_pub, u.disabled FROM hero_keys k JOIN users u ON u.id = k.user_id \
+         WHERE k.key_id = ? AND k.revoked_at IS NULL",
+    )
+    .bind(key_id)
+    .fetch_optional(&state.db)
+    .await?;
+    let failed = "That Hero Key didn't work. It may have been replaced by a newer one: paste your newest key, or sign in with Google and make a new one.";
+    let Some((uid, stored, disabled)) = row else {
+        audit::log(&state.db, None, ip.as_deref(), "login.fail", Some("herokey"), Some("launcher")).await;
+        return Ok(no(StatusCode::UNAUTHORIZED, failed));
+    };
+    // a key made before Hero IDs has no public half yet: the browser's key page fills it in once
+    let Some(stored) = stored.and_then(|p| <[u8; 32]>::try_from(p.as_slice()).ok()) else {
+        return Ok(no(StatusCode::CONFLICT, "Sign in once with this key on the realm's website (I have a Hero Key), then here again."));
+    };
+    let ok = {
+        use subtle::ConstantTimeEq;
+        let same: bool = parse_hero(&f.hero).is_some_and(|h| h.ct_eq(&stored).into());
+        same && hero_verify(&stored, format!("{CHALLENGE_MESSAGE}{}", f.challenge).as_bytes(), &f.sig)
+    };
+    if !ok {
+        audit::log(&state.db, None, ip.as_deref(), "login.fail", Some("herokey"), Some("launcher")).await;
+        return Ok(no(StatusCode::UNAUTHORIZED, failed));
+    }
+    if disabled != 0 {
+        return Ok(no(StatusCode::FORBIDDEN, "This account is disabled — ask an admin."));
+    }
+    let ua = headers.get("user-agent").and_then(|v| v.to_str().ok());
+    mark_used(&state.db, key_id, ua).await;
+    let out = super::launcher::issue(&state, &headers, uid).await?;
+    audit::log(&state.db, Some(uid), ip.as_deref(), "login.ok", Some("herokey"), Some("launcher")).await;
+    Ok(super::launcher::no_store((StatusCode::OK, Json(out)).into_response()))
+}
+
+#[derive(serde::Deserialize, Default)]
+struct LauncherKeyBody {
+    #[serde(default)]
+    replace: bool,
+}
+
+/// `POST /api/launcher/herokey` (Open Vanilla 0042), with the launcher's token: the account's Hero Key
+/// for the launcher to keep. No key yet: one is made and returned (`{"key": "ovk1..."}`). A key
+/// already: `{"has_key": true, "key_id": ...}` (the realm never has its secret), unless
+/// `{"replace": true}`, which makes a new one (the old one stops working at once).
+async fn launcher_herokey(
+    State(state): State<Arc<AppState>>,
+    headers: HeaderMap,
+    body: Option<Json<LauncherKeyBody>>,
+) -> Result<Response, AppError> {
+    let ip = client_ip(&headers);
+    if !state.limiter.allow(&format!("launcher:herokey:{}", net_of(&headers)), 10, 900) {
+        return Err(AppError::TooMany);
+    }
+    let Some(uid) = super::launcher::token_user(&state, &headers).await? else {
+        return Ok(json_status(StatusCode::UNAUTHORIZED, serde_json::json!({ "message": "Signed out — sign in again." })));
+    };
+    let replace = body.map(|b| b.0.replace).unwrap_or(false);
+    if !replace {
+        if let Some(k) = info(&state.db, uid).await? {
+            return Ok(json_status(StatusCode::OK, serde_json::json!({ "has_key": true, "key_id": k.key_id })));
+        }
+    }
+    let key = mint(&state.db, uid).await?;
+    let _ = mark_saved(&state.db, uid).await;     // the launcher keeps it: no reminder in game
+    audit::log(&state.db, Some(uid), ip.as_deref(), "herokey.new", Some("launcher"), None).await;
+    Ok(json_status(StatusCode::OK, serde_json::json!({ "key": key })))
+}
